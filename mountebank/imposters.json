{
  "imposters": [
    {
      "port": 8882,
      "protocol": "http",
      "defaultResponse": {
        "statusCode": 404,
        "headers": {
          "Connection": "Keep-Alive",
          "Content-Length": 0
        }
      },
      "stubs": [
        {
          "name": "payment visa",
          "predicates": [
            {
              "equals": {
                "method": "POST",
                "path": "/payment/visa"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 200,
                "headers": {
                  "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                  "status": "success",
                  "fee": 0.0,
                  "available_balance": 2401.98,
                  "authorized": "${TIME}",
                  "transaction_id": "TOY202002021525"
                }
              },
              "behaviors": [
                {
                  "wait": 500
                },
                {
                  "decorate": "config => { config.response.body.authorized = new Date().toISOString(); }"
                }
              ]
            }
          ]
        },
        {
          "name": "shipping kerry",
          "predicates": [
            {
              "equals": {
                "method": "POST",
                "path": "/shipping"
              }
            }
          ],
          "responses": [
            {
              "inject": "<%-stringify(filename, 'response.js') %>"
            }
          ]
        }
      ]
    }
  ]
}
